{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "ignoreDeprecations": "6.0",
    "declaration": true,
    "declarationMap": true,
    "lib": ["ESNext", "DOM"],
    "types": ["reflect-metadata"],
    "outDir": "dist/lib"
  },
  "include": ["packages/core/src/**/*", "packages/cli/bin/**/*"],
  "exclude": ["node_modules", "dist"]
}
