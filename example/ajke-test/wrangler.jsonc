{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ajke-test",
  "main": "./src/index.ts",
  "compatibility_date": "2025-06-17",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "MODE": "development",
    "JWT_SECRET": "local-dev-secret-change-in-production",
    "JWT_EXPIRES_IN": "7d",
    "JWT_REFRESH_EXPIRES_IN": "30d",
    "OTP_SECRET": "local-otp-secret",
    "OTP_EXPIRY_SEC": "300",
    "ROOT_USER_EMAIL": "root@admin.com",
    "MAIL_FROM": "noreply@example.com",
    "WEB_ORDER_TRACKING_BASE_URL": "https://example.com/track",
    "SLACK_ORDER_CHANNEL_ID": "",
    "SLACK_WEBHOOK_URL": "",
    "FCM_PROJECT_ID": "",
    "SSL_STORE_ID": "",
    "SSL_STORE_PASSWORD": ""
  },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ajke-test-db",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
      "preview_database_id": "00000000-0000-0000-0000-000000000002"
    }
  ],
  "queues": {
    "producers": [
      { "queue": "order-placed-queue", "binding": "ORDER_QUEUE" },
      { "queue": "order-events-queue", "binding": "ORDER_EVENTS_QUEUE" }
    ],
    "consumers": [
      { "queue": "order-placed-queue", "max_batch_size": 10, "max_batch_timeout": 5 },
      { "queue": "order-events-queue", "max_batch_size": 10, "max_batch_timeout": 5 }
    ]
  },
  "r2_buckets": [
    { "binding": "STORAGE", "bucket_name": "ajke-storage" }
  ],
  "dev": { "port": 4001 }
}
